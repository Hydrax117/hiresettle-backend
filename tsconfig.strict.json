{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strictNullChecks": true
  },
  "include": [
    "src/main.ts",
    "src/app.module.ts",
    "src/tracing.ts",
    "src/common/**/*.ts",
    "src/config/**/*.ts",
    "src/graphql/**/*.ts",
    "src/metrics/**/*.ts",
    "src/modules/**/*.ts",
    "src/queues/**/*.ts",
    "src/cli/**/*.ts",
    "src/integration/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "scripts", "test"]
}
